load("@dbsyncd_tests_pip//:requirements.bzl", "requirement")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The test application, not the reusable package, supplies its SONiC runtime.
_RUNTIME_DEPS = [
    "@sonic_dbsyncd//:lldp_syncd",
    "@sonic_buildimage//src/sonic-py-common:sonic_py_common",
]

py_binary(
    name = "unit_runner",
    testonly = True,
    srcs = ["unit_runner.py"],
    data = ["@sonic_dbsyncd//:test_sources"],
    legacy_create_init = False,
    python_version = "3.13",
    deps = _RUNTIME_DEPS + [
        requirement("mock"),
        requirement("pytest"),
        requirement("mockredispy"),
        requirement("swsssdk"),
        requirement("redis"),
    ],
)

sh_test(
    name = "unit_tests",
    size = "large",
    timeout = "long",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath @sonic_swss_common//tools/bazel/runtime:test_runtime)",
        "-",
        "enabled",
        "$(rootpath :unit_runner)",
        "$(rootpath @sonic_dbsyncd//:setup.py)",
    ],
    data = [
        ":unit_runner",
        "@sonic_dbsyncd//:setup.py",
        "@sonic_dbsyncd//:test_sources",
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

py_binary(
    name = "installed_wheel_runner",
    testonly = True,
    srcs = ["installed_wheel_probe.py"],
    data = [
        "native_redis_probe.py",
        "@sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel",
        "@sonic_dbsyncd//:sonic_dbsyncd_runtime",
        "@sonic_dbsyncd//:sonic_dbsyncd_wheel",
        "@sonic_dbsyncd//:test_sources",
    ],
    legacy_create_init = False,
    main = "installed_wheel_probe.py",
    python_version = "3.13",
    deps = _RUNTIME_DEPS + ["@sonic_buildimage//tools/bazel/tests:wheel_test_helpers"],
)

sh_test(
    name = "installed_wheel_test",
    size = "medium",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath @sonic_buildimage//src/sonic-eventd:test_runtime)",
        "-",
        "enabled",
        "$(rootpath :installed_wheel_runner)",
        "--wheel=$(rootpath @sonic_dbsyncd//:sonic_dbsyncd_wheel)",
        "--runtime-tar=$(rootpath @sonic_dbsyncd//:sonic_dbsyncd_runtime)",
        "--setup=$(rootpath @sonic_dbsyncd//:setup.py)",
        "--common-wheel=$(rootpath @sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel)",
        "--redis-probe=$(rootpath native_redis_probe.py)",
    ],
    data = [
        "native_redis_probe.py",
        ":installed_wheel_runner",
        "@sonic_buildimage//src/sonic-eventd:test_runtime",
        "@sonic_buildimage//src/sonic-py-common:sonic_py_common_wheel",
        "@sonic_dbsyncd//:setup.py",
        "@sonic_dbsyncd//:sonic_dbsyncd_runtime",
        "@sonic_dbsyncd//:sonic_dbsyncd_wheel",
        "@sonic_dbsyncd//:test_sources",
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
